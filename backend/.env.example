PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/edupredict_db
DB_SSL=true
# Optional trusted CA PEM; use literal \n for line breaks.
# DB_SSL_CA=
DB_QUERY_RETRIES=2
DB_LOG_QUERIES=false
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Optional comma-separated exact trusted frontend origins (e.g. a branch preview).
# FRONTEND_URLS=https://your-frontend-git-your-branch.vercel.app
# Number of trusted reverse-proxy hops. Defaults to 1 on Vercel/Render, 0 locally.
# TRUST_PROXY=1
PREDICTION_SEED_TIMEOUT_MS=4000
CHATBOT_API_URL=https://final-iug-chat-botv3.onrender.com
QUESTION_GENERATOR_API_URL=https://question-generator-api-pol9.onrender.com
EDUPREDICT_API_URL=https://edupredict-api-6ob5.onrender.com
LECTURESCRIBE_API_URL=https://lecturescribe-ai.onrender.com
# Required in production (the server warns at startup on Vercel/Render without it):
# one of the LectureScribe service's GATEWAY_KEYS. It enables completion callbacks
# and limits each student individually instead of this server's single address.
# LECTURESCRIBE_GATEWAY_KEY=
# With the gateway key set, LectureScribe reports finished jobs to
# <this API>/api/lecture-scribe/callback (signed with that key) so transcripts are
# stored even when no student is watching. Derived from the request host when it
# is public HTTPS; set it explicitly behind a proxy or custom domain, e.g.
# LECTURESCRIBE_CALLBACK_URL=https://your-api.example.com/api/lecture-scribe/callback
# Backstop that settles lost jobs and stores transcripts the service still holds:
# npm run lectures:sync (the GitHub workflow runs it when the repository variable
# ENABLE_LECTURE_SYNC is 'true'; LECTURE_SYNC_BUDGET_MS bounds a run). It cannot
# replace callbacks: the service forgets finished jobs when it restarts.
ADMIN_API_KEY=change-this-admin-key

# Independent lecture workspace. Existing chatbot/question-generator settings are unchanged.
LECTURE_STUDY_ENABLED=false
# LEARNING_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/learning
LEARNING_DB_SSL=true
# LEARNING_DB_SSL_CA=
LECTURE_STUDY_MAX_DB_MB=500
# Python on the machine running the worker (not needed on the web gateway).
LECTURE_STUDY_PYTHON=python
LECTURE_STUDY_OLLAMA_URL=http://127.0.0.1:11434
LECTURE_STUDY_MODEL=qwen2.5:7b-instruct
LECTURE_STUDY_EMBEDDINGS=true
# Optional: force CPU with 0, or select a GPU layer count. Unset uses Ollama's default.
# LECTURE_STUDY_GPU_LAYERS=0
# 32 random bytes encoded as base64; store separately from encrypted snapshots.
# LEARNING_BACKUP_KEY=

# Oral Exam: configure this group on the long-lived Render backend only.
# Names only; supply secrets through the hosting environment, never the frontend.
# Its examiner model is reached through OpenRouter's OpenAI-compatible
# chat-completions API. ORAL_EXAM_API_KEY is an OpenRouter key and is unrelated
# to GROQ_API_KEY, which still serves the lecture tools and academic assistant.
# ORAL_EXAM_ENABLED
# ORAL_EXAM_API_KEY
# ORAL_EXAM_API_BASE_URL=https://openrouter.ai/api/v1
# ORAL_EXAM_MODEL=openai/gpt-oss-120b
# ELEVENLABS_API_KEY
# ELEVENLABS_EN_VOICE_ID
# ELEVENLABS_AR_VOICE_ID

# Optional OpenRouter attribution headers. Both are safe, non-secret values and
# the exam works without them.
# ORAL_EXAM_APP_URL=https://your-frontend.example.com
# ORAL_EXAM_APP_TITLE=EduFusion Oral Exam

# Default distinct core-concept target per new Oral Exam (1–8).
# ORAL_EXAM_CORE_CONCEPTS=5

# GROQ_API_KEY alone enables the lecture tools (chat and practice questions over
# a saved transcript) and the academic assistant on whichever backend serves
# /api/lecture-scribe. Oral Exam no longer uses it.
# GROQ_API_KEY
