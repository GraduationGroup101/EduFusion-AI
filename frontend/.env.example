VITE_API_URL=/api
# The frontend's production build requires the deployed backend /api URL.
# VITE_API_URL=https://your-backend.example/api
# Optional Oral Exam gateway override; public URL only, ending in /api.
# Required when the main VITE_API_URL uses a serverless gateway.
# VITE_ORAL_EXAM_API_URL
# Optional override for lecture tools (chat and practice questions over a
# transcript); defaults to VITE_ORAL_EXAM_API_URL, then VITE_API_URL.
# VITE_LECTURE_TOOLS_API_URL
# Optional override for the Academic Chatbot (needs the backend with GROQ_API_KEY
# to answer academic-standing questions); defaults to VITE_ORAL_EXAM_API_URL,
# then VITE_API_URL.
# VITE_CHATBOT_API_URL
